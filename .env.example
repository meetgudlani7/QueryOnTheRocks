# ==========================================
# Voice-Enabled RAG System - Environment Configuration
# ==========================================
# Copy this file to .env and fill in your actual values

# ==========================================
# APPLICATION
# ==========================================
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# ==========================================
# GROQ CONFIGURATION
# ==========================================
# Get your API key from https://console.groq.com/
GROQ_API_KEY=

# Speech-to-Text Model (recommended: whisper-large-v3-turbo)
GROQ_STT_MODEL=whisper-large-v3-turbo

# LLM Model — check https://console.groq.com/docs/models for the current catalog,
# it changes over time. As of Aug 2026, fast+cheap+JSON-capable options are:
#   llama-3.1-8b-instant (recommended for the <200ms target)
#   openai/gpt-oss-20b (fastest, slightly pricier)
#   llama-3.3-70b-versatile (higher quality, ~2x slower)
GROQ_LLM_MODEL=llama-3.1-8b-instant

# ==========================================
# QDRANT CONFIGURATION
# ==========================================
# Qdrant Server URL
QDRANT_URL=http://localhost:6333

# Qdrant API Key (if using Qdrant Cloud)
QDRANT_API_KEY=

# Qdrant Collection Name
QDRANT_COLLECTION=msmarco_xi

# ==========================================
# DATASET CONFIGURATION
# ==========================================
# AI4Bharat MSMARCO-XI Dataset
DATASET_NAME=ai4bharat/MSMARCO-XI
DATASET_SPLIT=train
DATASET_LIMIT=
DATASET_CACHE_DIR=data/msmarco_xi

# ==========================================
# PROCESSING LIMITS
# ==========================================
MAX_CONTEXT_LENGTH=4096
MAX_RESPONSE_LENGTH=512
MAX_AUDIO_DURATION=60

# ==========================================
# PERFORMANCE TARGETS
# ==========================================
TARGET_LATENCY_MS=200.0

# ==========================================
# RETRIEVAL CONFIGURATION
# ==========================================
QDRANT_SEARCH_K=20
BM25_SEARCH_K=20
FUSION_K=5
RRF_CONSTANT=60

# ==========================================
# EMBEDDING CONFIGURATION
# ==========================================
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
